#!/usr/bin/env bash
#
# Применить тему dark|light: обновить state-файлы и перезагрузить приложения.
# Репозиторий не изменяется: пишем только в ~/.local/state/dotfiles.
#
#   theme-sync dark|light
#
# State-файлы пишет только этот скрипт; приложения читают их из фиксированного
# пути (XDG-дефолт). Перезагрузка уже запущенных приложений вынесена в
# wayland/theme-hooks.d/*.sh — один хук на приложение, см.
# wayland/theme-hook-lib.sh. Новое приложение = новый хук, theme-sync не
# трогаем.
#
# В конце переключает обои на подходящие под режим: wayland/wallpapers.sh
# выбирает только файлы *_dark / *_light.
#
# THEME_SYNC_NO_RELOAD=1 — только записать файлы (используется verify.sh).
# THEME_SYNC_NO_WALLPAPER=1 — не трогать обои.
# THEME_SYNC_NO_MATTERMOST=1 — не перезапускать Mattermost.
#
# Хуки не знают, было ли это реальной сменой режима: они сравнивают
# THEME_PREV_MODE с режимом, ради которого вызваны (см. 90-mattermost.sh).
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
# shellcheck source=wayland/compositor-env.sh
. "$REPO/wayland/compositor-env.sh"
# ВАЖНО: путь фиксирован (XDG-дефолт), потому что alacritty/rofi не умеют
# подставлять переменные окружения в import-пути. При смене XDG_STATE_HOME
# нужно править и эти конфиги.
STATE="$HOME/.local/state/dotfiles"

mode="${1:-}"
case "$mode" in
    dark|light) ;;
    *) echo "usage: $0 dark|light" >&2; exit 2 ;;
esac

mkdir -p "$STATE/alacritty" "$STATE/helix/runtime/themes" "$STATE/ironbar"

prev_mode="$(cat "$STATE/background-mode" 2>/dev/null || true)"
printf '%s\n' "$mode" > "$STATE/background-mode"

# cat > файл сохраняет inode (нужно для inotify-вотчеров ironbar).
copy() { # copy <src> <dst>
    [[ -f "$1" ]] || return 0
    cat "$1" > "$2"
}

copy "$REPO/theme/$mode/alacritty.toml" "$STATE/alacritty.toml"
copy "$REPO/theme/$mode/rofi.rasi"      "$STATE/rofi.rasi"
copy "$REPO/theme/$mode/helix.toml"     "$STATE/helix/runtime/themes/dotfiles.toml"

# Ironbar: палитра + обёртка. GTK не раскрывает ~ в @import, поэтому пути
# абсолютные; REPO вычисляется из расположения скрипта.
copy "$REPO/theme/$mode/ironbar.css" "$STATE/ironbar/colors.css"
{
    printf '/* generated by theme-sync: mode=%s */\n' "$mode"
    printf '@import url("%s");\n' "$STATE/ironbar/colors.css"
    printf '@import url("%s");\n' "$REPO/ironbar/style.css"
} > "$STATE/ironbar/style.css"

[[ ${THEME_SYNC_NO_RELOAD:-0} == 1 ]] && exit 0

# Композитор мог быть перезапущен уже после старта darkman.service, и тогда
# унаследованные NIRI_SOCKET/SWAYSOCK указывают в никуда: обои и Mattermost
# молча пропускались. Резолвим живой сокет заново и экспортируем его.
compositor_ok=0
theme_compositor_resolve && compositor_ok=1

gui=0
theme_display_alive && gui=1

# Лог хуков: не даём расти бесконечно (пара переключений в день).
HOOK_LOG="$STATE/theme-hooks.log"
if [[ -f "$HOOK_LOG" ]] && (( $(stat -c %s "$HOOK_LOG" 2>/dev/null || echo 0) > 65536 )); then
    tail -n 200 "$HOOK_LOG" > "$HOOK_LOG.tmp" && mv "$HOOK_LOG.tmp" "$HOOK_LOG"
fi
printf '%s ==== switching to %s (prev=%s gui=%s compositor=%s)\n' \
    "$(date '+%F %T')" "$mode" "${prev_mode:-none}" "$gui" "$compositor_ok" >>"$HOOK_LOG"

# Хуки применяются по алфавиту. timeout защищает переключение темы от
# зависшего приложения; падение хука — только строка в логе.
shopt -s nullglob
hooks=( "$REPO"/wayland/theme-hooks.d/*.sh )
shopt -u nullglob

if (( ${#hooks[@]} == 0 )); then
    printf '%s no hooks in %s\n' "$(date '+%F %T')" "$REPO/wayland/theme-hooks.d" >>"$HOOK_LOG"
fi

for hook in "${hooks[@]}"; do
    name="${hook##*/}"
    [[ -x "$hook" ]] || { printf '%s %s not executable, skipped\n' "$(date '+%F %T')" "$name" >>"$HOOK_LOG"; continue; }
    rc=0
    # timeout есть в coreutils; без него хук всё равно выполнится (риск —
    # зависшее приложение задержит переключение).
    runner=()
    command -v timeout >/dev/null 2>&1 && runner=( timeout 15 )
    env \
        THEME_STATE="$STATE" \
        THEME_HOOK_LOG="$HOOK_LOG" \
        THEME_PREV_MODE="$prev_mode" \
        THEME_GUI="$gui" \
        "${runner[@]}" "$hook" "$mode" >>"$HOOK_LOG" 2>&1 || rc=$?
    (( rc == 0 )) || printf '%s %s rc=%s\n' "$(date '+%F %T')" "$name" "$rc" >>"$HOOK_LOG"
done

# Обои под новый режим: иначе в dark останется светлая картинка (и наоборот).
# Запускаем фоново — первый выбор панорамных нарезает половинки и не должен
# тормозить переключение темы. Композитор проверяется по живому сокету: при
# запуске из TTY/verify.sh wallpapers.sh иначе ругнётся "neither sway nor niri
# is running".
if [[ -z "${THEME_SYNC_NO_WALLPAPER:-}" ]] && (( compositor_ok )); then
    wlog="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/wallpapers.log"
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$REPO/wayland/wallpapers.sh" >>"$wlog" 2>&1 || true
    else
        nohup "$REPO/wayland/wallpapers.sh" >>"$wlog" 2>&1 &
        disown 2>/dev/null || true
    fi
fi
