#!/usr/bin/env bash
#
# Применить тему dark|light: обновить state-файлы и перезагрузить приложения.
# Репозиторий не изменяется: пишем только в ~/.local/state/dotfiles.
#
#   theme-sync dark|light
#
# В конце (в reload-ветке) переключает обои на подходящие под режим:
# wayland/wallpapers.sh выбирает только файлы *_dark / *_light.
#
# THEME_SYNC_NO_RELOAD=1 — только записать файлы (используется verify.sh).
# THEME_SYNC_NO_WALLPAPER=1 — не трогать обои.
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
REPO="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
# ВАЖНО: путь фиксирован (XDG-дефолт), потому что alacritty/rofi не умеют
# подставлять переменные окружения в import-пути. При смене XDG_STATE_HOME
# нужно править и эти конфиги.
STATE="$HOME/.local/state/dotfiles"

mode="${1:-}"
case "$mode" in
    dark|light) ;;
    *) echo "usage: $0 dark|light" >&2; exit 2 ;;
esac

mkdir -p "$STATE/alacritty" "$STATE/helix/runtime/themes" "$STATE/ironbar"

printf '%s\n' "$mode" > "$STATE/background-mode"

# cat > файл сохраняет inode (нужно для inotify-вотчеров ironbar).
copy() { # copy <src> <dst>
    [[ -f "$1" ]] || return 0
    cat "$1" > "$2"
}

copy "$REPO/theme/$mode/alacritty.toml" "$STATE/alacritty.toml"
copy "$REPO/theme/$mode/rofi.rasi"      "$STATE/rofi.rasi"
copy "$REPO/theme/$mode/helix.toml"     "$STATE/helix/runtime/themes/dotfiles.toml"

# Ironbar: палитра + обёртка. GTK не раскрывает ~ в @import, поэтому пути
# абсолютные; REPO вычисляется из расположения скрипта.
copy "$REPO/theme/$mode/ironbar.css" "$STATE/ironbar/colors.css"
{
    printf '/* generated by theme-sync: mode=%s */\n' "$mode"
    printf '@import url("%s");\n' "$STATE/ironbar/colors.css"
    printf '@import url("%s");\n' "$REPO/ironbar/style.css"
} > "$STATE/ironbar/style.css"

[[ ${THEME_SYNC_NO_RELOAD:-0} == 1 ]] && exit 0

# GTK / xdg-desktop-portal
if command -v gsettings >/dev/null 2>&1; then
    if [[ $mode == dark ]]; then
        gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3-dark 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme prefer-dark 2>/dev/null || true
    else
        gsettings set org.gnome.desktop.interface gtk-theme adw-gtk3 2>/dev/null || true
        gsettings set org.gnome.desktop.interface color-scheme prefer-light 2>/dev/null || true
    fi
fi

# Alacritty: live_config_reload следит только за основным конфигом, изменения
# импортированных файлов он НЕ замечает (проверено на 0.1x через IPC:
# get-config не меняется после правки state). Поэтому уже запущенным окнам
# палитру и прозрачность отправляем через IPC.
# Важно: darkman вызывается как systemd user service без переменной ALACRITTY_SOCKET,
# поэтому перебираем все сокеты запущенных процессов в $XDG_RUNTIME_DIR и /tmp.
# Новые окна читают state сами через импорт.
if command -v alacritty >/dev/null 2>&1; then
    palette=$(sed -n 's/^import = \["\(.*\)"\]$/\1/p' "$REPO/theme/$mode/alacritty.toml" | head -n 1)
    palette=${palette/#\~/$HOME}
    opacity=$(sed -n 's/^opacity *= *//p' "$REPO/theme/$mode/alacritty.toml" | head -n 1)
    if [[ -r $palette ]]; then
        config_args=$(awk -F"'" '
            /^\[colors\./ { section = $0; gsub(/^\[|\]$/, "", section); next }
            section != "" && /^[a-z_]+[ \t]*=/ {
                key = $1; gsub(/[ \t=]/, "", key);
                printf "%s.%s=\"%s\" ", section, key, $2;
            }
        ' "$palette")
        config_args="$config_args window.opacity=${opacity:-1.0}"

        shopt -s nullglob
        sockets=( "${XDG_RUNTIME_DIR:-/run/user/$UID}"/Alacritty*.sock /tmp/Alacritty*.sock )
        shopt -u nullglob

        # shellcheck disable=SC2086 # нужен word splitting для аргументов config
        if [[ ${#sockets[@]} -gt 0 ]]; then
            for sock in "${sockets[@]}"; do
                [[ -S "$sock" ]] || continue
                env -u ALACRITTY_SOCKET alacritty msg -s "$sock" config -w -1 $config_args 2>/dev/null || true
            done
        elif alacritty msg get-config >/dev/null 2>&1; then
            alacritty msg config -w -1 $config_args 2>/dev/null || true
        fi
    fi
fi

# Helix перечитывает конфиг и тему по SIGUSR1.
pkill -USR1 -x helix 2>/dev/null || true
pkill -USR1 -x hx 2>/dev/null || true

# tmux (>= 3.8): alacritty отвечает на OSC 11, но не поддерживает DECSET 2031,
# поэтому после IPC-смены палитры уже подключённый клиент tmux не узнает о новой
# теме сам. Форсируем режим явно; на старых tmux такой опции нет — глушим ошибку.
# list-sessions не даёт поднять сервер, если tmux сейчас не запущен.
if command -v tmux >/dev/null 2>&1 && tmux list-sessions >/dev/null 2>&1; then
    tmux set -s theme "$mode" 2>/dev/null || true
fi

# Уже открытые Neovim.
if [[ -x "$HOME/.cargo/bin/nvim-ctrl" ]]; then
    "$HOME/.cargo/bin/nvim-ctrl" "set background=$mode" 2>/dev/null || true
fi

# rofi / fish / ironbar подхватывают изменения сами:
# rofi — при следующем запуске, fish — на следующем промпте,
# ironbar — watcher обёртки.

# Обои под новый режим: иначе в dark останется светлая картинка (и наоборот).
# Запускаем фоново — первый выбор панорамных нарезает половинки и не должен
# тормозить переключение темы. THEME_SYNC_NO_WALLPAPER=1 — не трогать обои.
# Композитор проверяется по живому сокету: при запуске из TTY/verify.sh
# wallpapers.sh иначе ругнётся "neither sway nor niri is running".
if [[ -z "${THEME_SYNC_NO_WALLPAPER:-}" ]] \
    && { [[ -n "${NIRI_SOCKET:-}" && -S "${NIRI_SOCKET}" ]] \
        || [[ -n "${SWAYSOCK:-}" && -S "${SWAYSOCK}" ]]; }; then
    wlog="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/wallpapers.log"
    if command -v setsid >/dev/null 2>&1; then
        setsid -f "$REPO/wayland/wallpapers.sh" >>"$wlog" 2>&1 || true
    else
        nohup "$REPO/wayland/wallpapers.sh" >>"$wlog" 2>&1 &
        disown 2>/dev/null || true
    fi
fi
