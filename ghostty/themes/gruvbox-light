# Gruvbox Light (medium) — палитра терминала.
#
# Файл темы ghostty: обычный config-сниппет, ключи `theme`/`config-file` внутри
# запрещены, остальное — как в config.ghostty.
#
# Источник цветов: alacritty/themes/themes/gruvbox_light.toml.
# install/verify.sh сверяет hex, чтобы палитры терминалов не разъехались.

background = fbf1c7
foreground = 3c3836
# Выделение: bg2 — тёплое затемнение под светлую палитру (значения сверяются
# install/verify.sh с [colors.selection] в alacritty/themes/themes/gruvbox_light.toml).
selection-background = d5c4a1
selection-foreground = 3c3836

palette = 0=fbf1c7
palette = 1=cc241d
palette = 2=98971a
palette = 3=d79921
palette = 4=458588
palette = 5=b16286
palette = 6=689d6a
palette = 7=7c6f64
palette = 8=928374
palette = 9=9d0006
palette = 10=79740e
palette = 11=b57614
palette = 12=076678
palette = 13=8f3f71
palette = 14=427b58
palette = 15=3c3836

# Как в alacritty (state-файл тем alacritty): светлая тема непрозрачная.
background-opacity = 1.0
