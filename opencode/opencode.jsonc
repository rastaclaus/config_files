  "mcp": {
    "servers": {
      "vision": {
        "type": "local",
        "command": [
          "mcp-vision-bridge"
        ],
        "environment": {
          "VISION_OPENAI_BASE_URL": "https://routerai.ru/api/v1",
          "VISION_OPENAI_API_KEY": "{env:ROUTERAI_API_KEY}",
          "VISION_MODEL": "qwen/qwen3-vl-8b-instruct"
        }
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "docs": {
        "type": "remote",
        "url": "http://172.20.77.57:6280/mcp",
        "timeout": {
          "catalog": 30000
        }
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
