[connection]
id=@CONN_ID@
uuid=@UUID@
type=vpn
autoconnect=false

[vpn]
ca=@CERTDIR@/@CA@
cert=@CERTDIR@/@CERT@
cert-pass-flags=0
challenge-response-flags=2
cipher=AES-256-CBC
comp-lzo=adaptive
connection-type=password-tls
dev=tun
dev-type=tun
key=@CERTDIR@/@KEY@
password-flags=1
remote=@REMOTE@
remote-cert-tls=server
reneg-seconds=36000
ta=@CERTDIR@/@TA@
ta-dir=1
username=@USER@
service-type=org.freedesktop.NetworkManager.openvpn

[ipv4]
@IPV4_EXTRA@
method=auto

[ipv6]
addr-gen-mode=stable-privacy
method=auto

[proxy]
