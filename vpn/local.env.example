# Local VPN parameters for install/install_vpn.sh.
#
# Copy to vpn/local.env and fill in. vpn/local.env is gitignored and must
# NEVER be committed — it may contain your login/endpoints and local paths.
#
#   cp vpn/local.env.example vpn/local.env

# OpenVPN account name used by NetworkManager (username= in the profile).
# Quote values that contain spaces or shell special characters.
VPN_USER="CHANGE_ME"

# Comma-separated list of OpenVPN endpoints (host:port).
VPN_REMOTE="vpn.example.com:1194"

# Directory holding the ca/cert/key/tls-auth PEM files.
# Optional; defaults to $HOME/vpn/nm-openvpn.
#VPN_CERT_DIR="$HOME/vpn/nm-openvpn"
