{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "ask",
    "bash": "ask"
  },
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ],
      "enabled": true,
      "environment": {
        "ALLOWED_PATHS": "src,tests,config,*.md,*.json,*.yaml,*.toml",
        "MAX_FILE_SIZE": "100000"
      }
    },
    "tree-sitter": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@nendo/tree-sitter-mcp"
      ],
      "enabled": true,
      "environment": {
        "MAX_TOKENS_PER_NODE": "512",
        "INCLUDE_COMMENTS": "false",
        "LANGUAGES": "typescript,javascript,python,go"
      }
    },
    "memory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "enabled": true,
      "environment": {
        "MEMORY_FILE_PATH": ".opencode/memory.json"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "bothub": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "BotHub",
