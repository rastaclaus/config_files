[connection]
id=ntech
uuid=266c4ebc-5eb0-4976-b821-4c0941bd1947
type=vpn
autoconnect=false

[vpn]
ca=@CERTDIR@/ashestopalov-ca.pem
cert=@CERTDIR@/ashestopalov-cert.pem
cert-pass-flags=0
challenge-response-flags=2
cipher=AES-256-CBC
comp-lzo=adaptive
connection-type=password-tls
dev=tun
dev-type=tun
key=@CERTDIR@/ashestopalov-key.pem
password-flags=1
remote=@REMOTE@
remote-cert-tls=server
reneg-seconds=36000
ta=@CERTDIR@/ashestopalov-tls-auth.pem
ta-dir=1
username=@USER@
service-type=org.freedesktop.NetworkManager.openvpn

[ipv4]
dns=172.16.101.62;172.17.145.129;
dns-priority=-100
ignore-auto-dns=true
method=auto
never-default=true
route1=40.69.31.15/32,172.20.78.9,50
route2=40.127.162.6/32,172.20.78.9,50
route3=172.16.0.0/12,172.20.78.9,50

[ipv6]
addr-gen-mode=stable-privacy
method=auto

[proxy]
