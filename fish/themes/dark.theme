# name: 'Gruvbox Dark'
# preferred_background: 282828
# Палитра согласована с gruvbox_dark.toml (alacritty/themes/themes).
# Цвета промпта заданы явно (hex): именованные green/brgreen/red рисуются
# палитрой терминала и на headless-хосте не меняются вместе с темой.

fish_color_normal ebdbb2
fish_color_command b8bb26
fish_color_quote fabd2f
fish_color_redirection ebdbb2
fish_color_end d3869b
fish_color_error fb4934
fish_color_param ebdbb2
fish_color_comment 928374
fish_color_match 83a598
fish_color_selection white --bold --background=504945
fish_color_search_match fabd2f --background=504945
fish_color_history_current --bold
fish_color_operator 83a598
fish_color_escape 8ec07c
fish_color_cwd b8bb26
fish_color_cwd_root fb4934
fish_color_valid_path --underline
fish_color_autosuggestion 928374
fish_color_user b8bb26
fish_color_host ebdbb2
fish_color_cancel -r
fish_pager_color_completion ebdbb2
fish_pager_color_description fabd2f
fish_pager_color_prefix ebdbb2 --bold --underline
fish_pager_color_progress brwhite --background=cyan
fish_pager_color_selected_background --background=504945
fish_color_option ebdbb2
fish_color_keyword b8bb26
fish_color_host_remote fabd2f
fish_color_status fb4934
