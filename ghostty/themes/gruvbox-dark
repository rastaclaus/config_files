# Gruvbox Dark (medium) — палитра терминала.
#
# Файл темы ghostty: обычный config-сниппет, ключи `theme`/`config-file` внутри
# запрещены, остальное — как в config.ghostty.
#
# Источник цветов: alacritty/themes/themes/gruvbox_dark.toml.
# install/verify.sh сверяет hex, чтобы палитры терминалов не разъехались.

background = 282828
foreground = ebdbb2
# Выделение: bg1 вместо bg2. bg2 (#504945) сам по себе светлый — на тёмном
# фоне он читается как подсветка из светлой темы. Значения сверяются
# install/verify.sh с [colors.selection] в alacritty/themes/themes/gruvbox_dark.toml.
selection-background = 3c3836
selection-foreground = ebdbb2

palette = 0=282828
palette = 1=cc241d
palette = 2=98971a
palette = 3=d79921
palette = 4=458588
palette = 5=b16286
palette = 6=689d6a
palette = 7=a89984
palette = 8=928374
palette = 9=fb4934
palette = 10=b8bb26
palette = 11=fabd2f
palette = 12=83a598
palette = 13=d3869b
palette = 14=8ec07c
palette = 15=ebdbb2

# Как в alacritty (state-файл тем alacritty): тёмная тема полупрозрачная.
background-opacity = 0.8
